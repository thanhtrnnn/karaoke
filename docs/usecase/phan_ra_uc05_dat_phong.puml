@startuml

left to right direction
skinparam packageStyle rectangle
actor "Khách hàng" as Client
actor "NV Lễ tân" as Receptionist

package "Hệ thống Quản lý Karaoke" {
usecase "Đặt phòng trực tuyến" as UC05a
usecase "Đặt phòng tại CN (Walk-in)" as UC05b
usecase "Xem phòng trống" as UC_view
usecase "Tìm kiếm khách hàng" as UC_search
usecase "Xác nhận đặt phòng" as UC_confirm
usecase "Check-in" as UC_checkin
usecase "Hủy đặt phòng" as UC_cancel

UC05a .> UC_view : <<include>>
UC05a .> UC_search : <<include>>
UC05a .> UC_confirm : <<include>>
UC05b .> UC_view : <<include>>
UC05b .> UC_search : <<include>>
UC05b .> UC_checkin : <<include>>
UC_cancel .> UC05a : <<extend>>
}

Client --> UC05a
Client --> UC_cancel
Receptionist --> UC05b
Receptionist --> UC05a
@enduml